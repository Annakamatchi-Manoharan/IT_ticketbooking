@{
    var title = (ViewData["Title"] as string) ?? "Dashboard";
}

<header class="sticky top-0 z-20 border-b border-white/10 bg-slate-950/40 backdrop-blur">
    <div class="px-4 sm:px-6 py-4 flex items-center gap-4">
        <button type="button" class="md:hidden h-10 w-10 rounded-xl bg-white/5 border border-white/10 grid place-items-center text-slate-200" data-open-sidebar aria-label="Open menu">
            ☰
        </button>

        <div class="min-w-0">
            <div class="text-lg font-semibold truncate">@title</div>
            <div class="text-xs text-slate-400 hidden sm:block">Support &nbsp;&rsaquo;&nbsp; @title</div>
        </div>

        <div class="ml-auto flex items-center gap-2 sm:gap-3">
            <div class="hidden lg:flex items-center gap-2 rounded-xl bg-white/5 border border-white/10 px-3 py-2 w-[min(360px,32vw)]">
                <span class="text-slate-400">⌕</span>
                <input class="bg-transparent outline-none text-sm w-full placeholder:text-slate-500" placeholder="Search tickets, assets, users..." />
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <div class="relative" id="notif-wrap">
                    <button id="notif-btn" class="relative h-10 w-10 rounded-xl bg-white/5 border border-white/10 grid place-items-center text-slate-200 hover:bg-white/10" type="button" title="Notifications">
                        🔔
                        <span id="notif-badge" class="hidden absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 rounded-full bg-rose-500 text-[10px] font-bold leading-[18px] text-center">0</span>
                    </button>
                    <div id="notif-panel" class="hidden absolute right-0 mt-2 w-80 max-h-96 overflow-y-auto rounded-2xl border border-white/10 bg-slate-950/95 shadow-2xl backdrop-blur z-50">
                        <div id="notif-list" class="text-left"></div>
                        <div class="border-t border-white/10 p-2 flex justify-end gap-2">
                            <button type="button" id="notif-markall" class="text-xs text-sky-300 hover:underline">Mark all read</button>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <button class="h-10 w-10 rounded-xl bg-white/5 border border-white/10 grid place-items-center text-slate-200" type="button" title="Notifications">🔔</button>
            }

            <div class="h-10 px-2 sm:px-3 rounded-xl bg-white/5 border border-white/10 flex items-center gap-2">
                <div class="h-7 w-7 rounded-full bg-white/10 grid place-items-center text-xs">
                    @(User.Identity?.Name?.FirstOrDefault().ToString().ToUpperInvariant() ?? "U")
                </div>
                <div class="text-sm max-w-[100px] sm:max-w-[140px] truncate hidden sm:block">@User.Identity?.Name</div>
            </div>
        </div>
    </div>
</header>
