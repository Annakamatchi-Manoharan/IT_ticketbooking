{
  "name": "enterprise-it-ticket-system",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "npm-run-all --parallel dev:api dev:web",
    "dev:api": "npm --workspace @itticket/api run dev",
    "dev:web": "npm --workspace @itticket/web run dev",
    "test": "npm-run-all test:api test:web",
    "test:api": "npm --workspace @itticket/api run test",
    "test:web": "npm --workspace @itticket/web run test"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
